# Backend EC2용 — docker-compose.backend.yml 과 같은 폴더에 .env 로 복사
# cp .env.backend.example .env
#
# DB_HOST: DB EC2의 private IP (같은 VPC)
# DB_USERNAME / DB_PASSWORD: DB EC2 .env 와 동일하게

DB_HOST=10.0.0.0
MYSQL_DATABASE=currentstream
DB_USERNAME=cs_user
DB_PASSWORD=cs_pass_change_me

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
