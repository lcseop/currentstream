<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeColor="#5038C5"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#F3F1FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="목표 추가"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="대상 멤버"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/dialog_teams_add_member_spinner"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edit_text_bg_1"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/dialog_teams_add_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#666666"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="목표 내용"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/dialog_teams_add_text"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edit_text_bg_1"
            android:paddingHorizontal="10dp"
            android:inputType="text"
            android:maxLength="200" />

        <TextView
            android:id="@+id/dialog_teams_add_text_warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="16dp"
            android:textColor="@color/register_red"
            android:textSize="12sp"
            android:visibility="invisible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="목표 기한"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/dialog_teams_add_date"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edit_text_bg_1"
            android:paddingHorizontal="10dp"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none" />

        <TextView
            android:id="@+id/dialog_teams_add_date_warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="16dp"
            android:textColor="@color/register_red"
            android:textSize="12sp"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_teams_add_cancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="취소"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:backgroundTint="#EEEEEE"
                android:textColor="#333333" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_teams_add_submit"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="추가"
                android:textAllCaps="false"
                android:enabled="false"
                app:cornerRadius="12dp"
                app:backgroundTint="#E8E6FF"
                app:strokeColor="#5038C5"
                app:strokeWidth="1dp"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
