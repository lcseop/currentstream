<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeColor="#5038C5"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#F3F1FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="멤버 초대"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="팀원 초대"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialog_invite_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="(0/5)"
                android:textSize="14sp"
                android:textColor="#666666" />
        </LinearLayout>

        <include
            android:id="@+id/dialog_invite_tag_input"
            layout="@layout/include_tag_input_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dialog_invite_list"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edit_list_bg_1"
            android:nestedScrollingEnabled="false"
            android:padding="8dp"
            tools:listitem="@layout/create_team_members" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_invite_cancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="취소"
                android:textAllCaps="false"
                android:textColor="#333333"
                app:backgroundTint="@null"
                android:background="@drawable/bg_dialog_btn_cancel"
                app:cornerRadius="12dp"
                app:rippleColor="@color/dialog_btn_ripple" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_invite_submit"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="초대하기"
                android:textAllCaps="false"
                android:enabled="false"
                android:textColor="#1A1A1A"
                app:backgroundTint="@null"
                android:background="@drawable/bg_dialog_btn_primary"
                app:cornerRadius="12dp"
                app:rippleColor="@color/dialog_btn_ripple" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
