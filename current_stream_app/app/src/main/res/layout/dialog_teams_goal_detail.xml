<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeColor="#5038C5"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#F3F1FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="목표 상세"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/dialog_teams_goal_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#333333"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_teams_goal_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/dialog_teams_goal_deadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="#666666" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="특이사항"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_teams_goal_remark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#555555"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_teams_goal_complete"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:text="완료됨"
            android:textAllCaps="false"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:backgroundTint="#4CAF50"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_teams_goal_confirm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="확인"
            android:textAllCaps="false"
            app:cornerRadius="12dp"
            app:backgroundTint="#E8E6FF"
            app:strokeColor="#5038C5"
            app:strokeWidth="1dp"
            android:textColor="#000000" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
